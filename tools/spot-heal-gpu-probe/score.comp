#version 450
#extension GL_ARB_gpu_shader_fp64 : require

// Research/profiling only, not an installed reconstruction backend. One
// invocation scores one candidate, with the serial FP64 accumulation order.
// Descriptors/locality are already prepared; this intentionally measures an
// optimistic offload floor without a dependency-breaking GPU search schedule.
layout(local_size_x = 64) in;
struct Pixel {
    dvec4 colorAlpha;
    vec2 texture;
    double baseWeight;
    uint gradient;
};
struct Candidate { uvec4 offsets; double locality; uvec2 reserved; };
layout(std430, binding=0) readonly buffer Target { Pixel target[]; };
layout(std430, binding=1) readonly buffer Original { Pixel original[]; };
layout(std430, binding=2) readonly buffer Candidates { Candidate candidate[]; };
layout(std430, binding=3) writeonly buffer Scores { double outputScore[]; };
layout(push_constant) uniform Settings { uint count; uint radius; uint width; uint reserved; } settings;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= settings.count) return;
    Candidate c = candidate[i];
    precise double cost = 0.0, weights = 0.0;
    uint sampleIndex = c.offsets.x;
    for (uint y = 0; y <= 2 * settings.radius; ++y) {
        uint source = c.offsets.y + y * settings.width;
        for (uint x = 0; x <= 2 * settings.radius; ++x, ++sampleIndex, ++source) {
            Pixel a = target[sampleIndex], b = original[source];
            if (a.baseWeight == 0.0) continue;
            precise double difference = 0.0;
            for (uint channel = 0; channel < 3; ++channel) {
                precise double d = a.colorAlpha[channel] - b.colorAlpha[channel];
                difference += d * d;
            }
            // The production alpha/texture subtraction is in float before
            // promotion. Preserve that rounding rather than silently refining
            // its precision in the GPU comparison.
            precise float alphaDifference = float(a.colorAlpha.w) - float(b.colorAlpha.w);
            precise double da = double(alphaDifference);
            difference = difference / 3.0LF + 0.15LF * da * da;
            if (a.gradient != 0) {
                for (uint channel = 0; channel < 2; ++channel) {
                    precise float textureDifference = a.texture[channel] - b.texture[channel];
                    precise double gradient = double(textureDifference);
                    difference += 0.65LF * gradient * gradient;
                }
            }
            precise double weight = a.baseWeight * double(min(float(a.colorAlpha.w), float(b.colorAlpha.w)));
            cost += weight * difference;
            weights += weight;
        }
    }
    outputScore[i] = weights < 0.25 ? double(uintBitsToFloat(0x7f800000u)) : cost / weights + c.locality;
}
