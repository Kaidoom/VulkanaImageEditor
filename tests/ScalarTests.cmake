if(NOT WIN32)
    foreach(target_mode srgb linear)
        set(channel_target_args --channels --validation)
        if(target_mode STREQUAL "linear")
            list(APPEND channel_target_args --linear-target)
        endif()
        add_test(NAME imageeditor_channel_vulkan_${target_mode} COMMAND imageeditor_blend_rendering_tests ${channel_target_args})
        set_tests_properties(imageeditor_channel_vulkan_${target_mode} PROPERTIES ENVIRONMENT "QT_QPA_PLATFORM=offscreen" TIMEOUT 90 LABELS "scalar;vulkan")
    endforeach()
endif()

