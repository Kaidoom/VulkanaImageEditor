    target_link_libraries(imageeditor_channel_persistence_tests PRIVATE MINIZIP::minizip-ng)
else()
    target_link_libraries(imageeditor_channel_persistence_tests PRIVATE PkgConfig::MINIZIP)
endif()
imageeditor_enable_warnings(imageeditor_channel_persistence_tests)
add_test(NAME imageeditor_channel_persistence_tests COMMAND imageeditor_channel_persistence_tests)
