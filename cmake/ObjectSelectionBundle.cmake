# Shipping inference inputs are immutable, reviewed artifacts. No configure-time
# downloads, Python tools, model export, stripping or runtime substitution.
set(VULKANA_OBJECT_SELECTION_BUNDLE "${PROJECT_SOURCE_DIR}/assets/object-selection/mobilesam-v1")
if(NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$" OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    message(FATAL_ERROR "Bundled Object Selection requires an x86-64 target.")
endif()
if(WIN32)
    set(VULKANA_WINDOWS_ONNX_ROOT "" CACHE PATH "Verified Windows ONNX Runtime SDK prepared by tools/windows/Setup.ps1")
    file(READ "${PROJECT_SOURCE_DIR}/tools/windows/dependencies/versions.json" _windows_versions)
    string(JSON _dll_hash GET "${_windows_versions}" onnxRuntime dllSha256)
    set(_runtime "${VULKANA_WINDOWS_ONNX_ROOT}/lib/onnxruntime.dll")
    if(NOT EXISTS "${_runtime}")
        message(FATAL_ERROR "Set VULKANA_WINDOWS_ONNX_ROOT to the runtime prepared by tools/windows/Setup.ps1.")
    endif()
    file(SHA256 "${_runtime}" _actual)
    if(NOT _actual STREQUAL _dll_hash)
        message(FATAL_ERROR "Windows ONNX Runtime differs from the verified CPU runtime.")
    endif()
    set(_model_source "${VULKANA_OBJECT_SELECTION_BUNDLE}")
    set(VULKANA_OBJECT_SELECTION_BUNDLE "${PROJECT_BINARY_DIR}/object-selection/mobilesam-v1")
    file(MAKE_DIRECTORY "${VULKANA_OBJECT_SELECTION_BUNDLE}")
    foreach(_file encoder.onnx decoder.onnx MobileSAM-LICENSE.txt ObjectSelection-NOTICE.txt)
        configure_file("${_model_source}/${_file}" "${VULKANA_OBJECT_SELECTION_BUNDLE}/${_file}" COPYONLY)
    endforeach()
    configure_file("${_runtime}" "${VULKANA_OBJECT_SELECTION_BUNDLE}/onnxruntime.dll" COPYONLY)
    configure_file("${VULKANA_WINDOWS_ONNX_ROOT}/LICENSE" "${VULKANA_OBJECT_SELECTION_BUNDLE}/ONNXRuntime-LICENSE.txt" COPYONLY)
    configure_file("${VULKANA_WINDOWS_ONNX_ROOT}/ThirdPartyNotices.txt" "${VULKANA_OBJECT_SELECTION_BUNDLE}/ONNXRuntime-ThirdPartyNotices.txt" COPYONLY)
    file(READ "${_model_source}/vulkana-mobilesam-v1.json" _manifest)
    string(JSON _manifest REMOVE "${_manifest}" "libonnxruntime.so")
    string(JSON _manifest SET "${_manifest}" "onnxruntime.dll" "\"${_dll_hash}\"")
    file(CONFIGURE OUTPUT "${VULKANA_OBJECT_SELECTION_BUNDLE}/vulkana-mobilesam-v1.json" CONTENT "${_manifest}\n" @ONLY)
    set(_runtime_file onnxruntime.dll)
    set(_runtime_hash "${_dll_hash}")
elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    set(_runtime_file libonnxruntime.so)
    set(_runtime_hash c902c70b3003c0e99fada202f37478c515ae9bba7944c2b2abd0017bae0c82ed)
else()
    message(FATAL_ERROR "Bundled Object Selection supports Linux and Windows x86-64.")
endif()
set(_object_files encoder.onnx decoder.onnx ${_runtime_file})
set(_object_hashes
    ab709cf1e7e70db9f09f76691ef761386c5f355c09e4541e6c1d793b1302ed6f
    f326153ab6436cd6f10cf900343c19ed1537ed86d0e537b9571e99ba9778745d
    ${_runtime_hash})
foreach(_index RANGE 2)
    list(GET _object_files ${_index} _file)
    list(GET _object_hashes ${_index} _expected)
    if(NOT EXISTS "${VULKANA_OBJECT_SELECTION_BUNDLE}/${_file}")
        message(FATAL_ERROR "Missing bundled Object Selection file: ${_file}. Restore the repository assets.")
    endif()
    file(SHA256 "${VULKANA_OBJECT_SELECTION_BUNDLE}/${_file}" _actual)
    if(NOT _actual STREQUAL _expected)
        message(FATAL_ERROR "Bundled Object Selection ${_file} differs from the quality-tested input.")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${VULKANA_OBJECT_SELECTION_BUNDLE}/${_file}")
endforeach()
